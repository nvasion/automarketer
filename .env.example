# ─────────────────────────────────────────────────────────────────────────────
# AutoMarketer — environment variable template
#
# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
#
# .env is listed in .gitignore — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=automarketer

# ── Application ───────────────────────────────────────────────────────────────
# Full connection URL used by the backend API (configured later).
# The hostname "db" matches the service name in docker-compose.yml.
DATABASE_URL=postgresql://postgres:change_me_in_production@db:5432/automarketer

# ── AI Content Generation ──────────────────────────────────────────────────────
# API keys for AI content generation are entered by users via the
# Settings → AI Settings page and stored in browser localStorage.
#
# Do NOT add a VITE_OPENROUTER_API_KEY here.  VITE_* variables are
# compiled into the client bundle, making any key trivially extractable
# by anyone who views the page source or inspects network requests.
# Server-side AI proxy support will be added in a future release.
