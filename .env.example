# ─────────────────────────────────────────────────────────────────────────────
# AutoMarketer — environment variable template
#
# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
#
# .env is listed in .gitignore — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=automarketer

# ── Application ───────────────────────────────────────────────────────────────
# Full connection URL used by the backend API (configured later).
# The hostname "db" matches the service name in docker-compose.yml.
DATABASE_URL=postgresql://postgres:change_me_in_production@db:5432/automarketer

# ── AI Content Generation ──────────────────────────────────────────────────────
# API keys for AI content generation are entered by users via the
# Settings → AI Settings page and stored in browser localStorage.
#
# Do NOT add a VITE_OPENROUTER_API_KEY here.  VITE_* variables are
# compiled into the client bundle, making any key trivially extractable
# by anyone who views the page source or inspects network requests.
# Server-side AI proxy support will be added in a future release.

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 64
JWT_SECRET=change_me_in_production

# Express API server port (Vite dev proxy forwards /api/* to this port)
PORT=3001

# Origin the app is served from. Serves two purposes:
#   1. Allowed CORS origin for the Express API.
#   2. Base for the OAuth redirect/callback URI used during token exchange.
#
# The OAuth callback URI is ALWAYS:  <FRONTEND_URL>/oauth/callback
#   • dev:  http://localhost:5173/oauth/callback
#   • prod: https://app.example.com/oauth/callback
#
# Register that EXACT URL (no trailing slash) as the Redirect/Callback URI in
# every platform's developer dashboard (LinkedIn Auth tab, Reddit app, etc.).
# FRONTEND_URL must match the origin you actually load the app from in the
# browser — if it doesn't, the redirect_uri sent at authorize time won't match
# the one sent at token-exchange time and the provider rejects it.
# REQUIRED in production — must be an exact origin, e.g. https://app.example.com
FRONTEND_URL=http://localhost:5173

# Vite dev proxy target port (should match PORT above)
API_PORT=3001

# ── Connected Platforms — OAuth 2.0 credentials (shared-app model) ───────────
# AutoMarketer uses ONE OAuth app per platform, shared across all users. Both
# the client ID and the client secret come from the environment variables below.
# Users never paste OAuth credentials — they just click "Connect".
#
#   <PLATFORM>_CLIENT_ID      Public identifier (appears in OAuth redirect URLs).
#   <PLATFORM>_CLIENT_SECRET  Confidential — used server-side to exchange the
#                             authorization code for an access token. Never
#                             commit real secrets to version control.
#
# A platform with no CLIENT_ID set is treated as "not available to connect".
# The CLIENT_ID and CLIENT_SECRET MUST belong to the SAME OAuth app, or the
# token exchange fails with "invalid_client".
#
# Instagram shares Facebook's Meta app — set only the FACEBOOK_* variables.

# LinkedIn (https://www.linkedin.com/developers/apps → Auth tab)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=change_me_in_production

# Twitter/X (https://developer.twitter.com/en/portal/dashboard)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=change_me_in_production

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=change_me_in_production

# Meta (Facebook / Instagram) (https://developers.facebook.com/apps — one Meta app for both)
# Set this once to enable OAuth for both Facebook and Instagram platforms.
META_CLIENT_ID=
META_CLIENT_SECRET=change_me_in_production

# ── Runtime environment ───────────────────────────────────────────────────────
# Uncomment for local development. Set to "production" in deployed environments.
# NODE_ENV=development

# ── Demo data ─────────────────────────────────────────────────────────────────
# Set to "true" to pre-populate the app with sample campaigns on first launch.
# Leave unset (or set to anything other than "true") for a clean empty state —
# this is the correct setting for production and for any fresh non-demo run.
#
# How it works:
#   - When VITE_SEED_DEMO_DATA=true, sample campaigns are written to localStorage
#     on startup and a "automarketer_demo_seeded" marker is stored alongside them.
#   - When VITE_SEED_DEMO_DATA is absent or not "true", init() automatically
#     removes any previously-seeded demo data (detected via the marker or by
#     matching the sample campaign IDs), so the app always starts empty.
#   - Real user-created campaigns are never touched by this mechanism.
#
# NEVER enable this in production — it is for local development / demos only.
# VITE_SEED_DEMO_DATA=true
