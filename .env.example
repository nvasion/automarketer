# ─────────────────────────────────────────────────────────────────────────────
# AutoMarketer — environment variable template
#
# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
#
# .env is listed in .gitignore — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=automarketer

# ── Application ───────────────────────────────────────────────────────────────
# Full connection URL used by the backend API (configured later).
# The hostname "db" matches the service name in docker-compose.yml.
DATABASE_URL=postgresql://postgres:change_me_in_production@db:5432/automarketer

# ── AI Content Generation ──────────────────────────────────────────────────────
# API keys for AI content generation are entered by users via the
# Settings → AI Settings page and stored in browser localStorage.
#
# Do NOT add a VITE_OPENROUTER_API_KEY here.  VITE_* variables are
# compiled into the client bundle, making any key trivially extractable
# by anyone who views the page source or inspects network requests.
# Server-side AI proxy support will be added in a future release.

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 64
JWT_SECRET=change_me_in_production

# Express API server port (Vite dev proxy forwards /api/* to this port)
PORT=3001

# Allowed CORS origin for the Express server.
# REQUIRED in production — must be an exact origin, e.g. https://app.example.com
FRONTEND_URL=http://localhost:5173

# Vite dev proxy target port (should match PORT above)
API_PORT=3001

# ── Connected Platforms — OAuth 2.0 client IDs ────────────────────────────────
# These are SERVER-SIDE variables read by the Express API at startup.
# They are NOT VITE_* variables — they are never compiled into the frontend
# bundle. The browser fetches them at runtime via GET /api/platform-config.
#
# Client IDs are public values — they appear in every OAuth redirect URL and
# are safe to expose. NEVER put client SECRETS here; secrets belong in a
# separate, non-public secret manager and are only used server-side during
# the authorization code exchange.
#
# Leave a value empty to disable OAuth for that platform. Users will see
# step-by-step setup instructions inside the connection modal instead.
#
# LinkedIn — https://www.linkedin.com/developers/apps
#   1. Create an app and note the Client ID on the "Auth" tab.
#   2. Under "Auth" → Authorized Redirect URLs add: <your-origin>/oauth/callback
#   3. Under "Products" request "Share on LinkedIn" and "Sign In with LinkedIn".
LINKEDIN_CLIENT_ID=

# Twitter / X — https://developer.twitter.com/en/portal/dashboard
#   1. Create a project + app; enable OAuth 2.0 under "User authentication settings".
#   2. Set App type to "Web App, Automated App or Bot".
#   3. Add Callback URI: <your-origin>/oauth/callback
#   4. Enable scopes: tweet.read, tweet.write, users.read, offline.access
#   5. Copy the OAuth 2.0 Client ID (not the API Key).
TWITTER_CLIENT_ID=

# Reddit — https://www.reddit.com/prefs/apps
#   1. Click "create another app", select type "web app".
#   2. Set redirect URI: <your-origin>/oauth/callback
#   3. The Client ID is the short string shown below the app name.
REDDIT_CLIENT_ID=

# Facebook + Instagram — https://developers.facebook.com/apps
#   Facebook and Instagram both use the same Meta App ID.
#   1. Create a Meta app; add "Facebook Login" and/or "Instagram Graph API" products.
#   2. Under Facebook Login → Settings add Valid OAuth Redirect URI: <your-origin>/oauth/callback
#   3. For Instagram also add the redirect URI under Instagram → Settings.
#   4. Request instagram_basic and instagram_content_publish permissions for Instagram.
#   5. Copy the App ID shown at the top of the app dashboard.
FACEBOOK_APP_ID=

# ── Runtime environment ───────────────────────────────────────────────────────
# Uncomment for local development. Set to "production" in deployed environments.
# NODE_ENV=development

# ── Demo data ─────────────────────────────────────────────────────────────────
# Set to "true" to pre-populate the app with sample campaigns on first launch.
# Leave unset (or set to anything other than "true") for a clean empty state —
# this is the correct setting for production and for any fresh non-demo run.
#
# How it works:
#   - When VITE_SEED_DEMO_DATA=true, sample campaigns are written to localStorage
#     on startup and a "automarketer_demo_seeded" marker is stored alongside them.
#   - When VITE_SEED_DEMO_DATA is absent or not "true", init() automatically
#     removes any previously-seeded demo data (detected via the marker or by
#     matching the sample campaign IDs), so the app always starts empty.
#   - Real user-created campaigns are never touched by this mechanism.
#
# NEVER enable this in production — it is for local development / demos only.
# VITE_SEED_DEMO_DATA=true
